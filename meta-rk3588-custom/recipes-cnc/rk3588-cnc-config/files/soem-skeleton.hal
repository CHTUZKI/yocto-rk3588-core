# Skeleton HAL — customize PDO mapping in soem_linuxcnc.c for your drives.
# 网口名由环境变量 SOEM_IFNAME 提供（见 /etc/rk3588-cnc/soem.env），勿用 HAL setp。

loadusr -Wn soem_linuxcnc soem_linuxcnc

