[Unit]
Description=Expand root filesystem to fill GPT partition
DefaultDependencies=no
After=local-fs.target
ConditionPathExists=!/etc/hd-rk3588-rootfs-expanded

[Service]
Type=oneshot
ExecStart=/usr/sbin/resize2fs /dev/disk/by-partlabel/rootfsA
ExecStartPost=/bin/touch /etc/hd-rk3588-rootfs-expanded
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
