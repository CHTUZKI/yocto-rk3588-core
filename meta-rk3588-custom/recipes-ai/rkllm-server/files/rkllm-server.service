[Unit]
Description=RKLLM OpenAI-compatible Flask server (Qwen3-4B)
After=network-online.target hd-rk3588-rootfs-expand.service
Wants=network-online.target
# Model is not in update.img (>4GiB limit); SCP to this path then: systemctl start rkllm-server
ConditionPathExists=/opt/models/Qwen3-4B-Instruct-2507-w8a8-rk3588.rkllm

[Service]
Type=simple
WorkingDirectory=/opt/rkllm_server
Environment=LD_LIBRARY_PATH=/opt/rkllm
Environment=PYTHONUNBUFFERED=1
# Keep interactive Qwen3 responses bounded; RKLLM fixes this at init.
Environment=RKLLM_MAX_CONTEXT=4096
Environment=RKLLM_MAX_NEW_TOKENS=768
ExecStart=/usr/bin/python3 /opt/rkllm_server/flask_server.py \
	--rkllm_model_path /opt/models/Qwen3-4B-Instruct-2507-w8a8-rk3588.rkllm \
	--target_platform rk3588
Restart=on-failure
RestartSec=5
# Model load is heavy; give it time before systemd kills it as failed.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
