[Unit]
Description=RKLLM OpenAI-compatible Flask server (Qwen3-4B)
After=network-online.target usb-automount.service
Wants=network-online.target
Wants=usb-automount.service
# No ConditionPathExists: model may be on eMMC or USB drive.
# start_server.sh auto-detects; if not found, it exits and systemd retries.

[Service]
Type=simple
WorkingDirectory=/opt/rkllm_server
Environment=LD_LIBRARY_PATH=/opt/rkllm
Environment=PYTHONUNBUFFERED=1
# Keep interactive Qwen3 responses bounded; RKLLM fixes this at init.
Environment=RKLLM_MAX_CONTEXT=4096
Environment=RKLLM_MAX_NEW_TOKENS=768
# start_server.sh auto-detects model path (eMMC or USB)
ExecStart=/opt/rkllm_server/start_server.sh
# Retry every 5s if model not found yet (USB may still be mounting)
Restart=on-failure
RestartSec=5
# Model load is heavy; give it time before systemd kills it as failed.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
